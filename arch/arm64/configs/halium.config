CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# Telnet
CONFIG_USB_CONFIGFS_RNDIS=y

# Kernel console on the panel, drawn into the framebuffer the bootloader
# already painted. Paired with framebuffer@a0000000 in lito.dts.
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_SIMPLE=y

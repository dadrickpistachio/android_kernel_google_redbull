CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# Telnet
CONFIG_USB_CONFIGFS_RNDIS=y

# bluebinder
CONFIG_BT_HCIVHCI=y

# BlueZ profiles
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# AppArmor
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# Waydroid
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
# waydroid-net.sh fills in the UDP checksums on DHCP replies to the container.
# Without this target that rule fails, the network script aborts, and the
# session never starts.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# Force DWARF4
CONFIG_DEBUG_INFO_DWARF4=y

# Turn off LTO
CONFIG_LTO_NONE=y


CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# The Halium initrd panic handler (scripts/panic/telnet) hardcodes
# USB_FUNCTIONS=rndis and brings the debug shell up on rndis0/usb0.
# redbull_defconfig leaves the RNDIS gadget function unset, so gadget
# setup fails and the handler reboots instead of giving us a shell.
# (Do not name the symbol in these comments - merge_config.sh greps
# the fragment for it and will match the comment line.)
CONFIG_USB_CONFIGFS_RNDIS=y

# On-screen kernel console. The cmdline already asks for console=tty0 and
# Halium already sets CONFIG_VT, but redbull_defconfig has no framebuffer
# at all, so tty0 binds to the dummy console and nothing is ever drawn.
# This is our only debug channel until a SuzyQ serial cable arrives:
# ramoops is wiped by the bootloader each boot and the USB gadget path
# needs a UDC we may never get.
#
# These two are prerequisites, not one approach among several. FB_SIMPLE
# below is "depends on (FB = y)", and FRAMEBUFFER_CONSOLE is what actually
# binds tty0 to the framebuffer once one exists. Do not remove either.
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# First attempt, kept only because it is currently load-bearing for the
# build: fbdev emulation on top of the msm DRM driver. It never put
# anything on the panel, because it needs that driver to probe first, and
# the driver depends on the same clocks/regulators/display stack we cannot
# bring up. Enabling it does force techpack/display/msm/Makefile to link
# msm_fbdev into msm_drm.ko, which is where the obj-/msm_drm- fix there
# matters. Retiring this symbol and that fix together is a separate,
# testable change - do not do it as a drive-by.
CONFIG_DRM_FBDEV_EMULATION=y

# Virtual HCI adapter, for bluebinder. The Bluetooth radio is driven by the
# Android vendor blob, not by any Linux driver, so BlueZ has no adapter to
# attach to. bluebinder bridges the two: it talks to the Android HAL over
# binder on one side, and on the other it opens /dev/vhci to present a fake
# but fully functional HCI adapter to BlueZ. redbull_defconfig has CONFIG_BT
# and BREDR/LE, but leaves the virtual driver out - so /dev/vhci never
# appears, bluebinder fails on its first open() and systemd restarts it in a
# loop (332 failures in the 2026-08-03 boot). Built in rather than modular so
# the node exists before bluebinder's first start attempt.
# (Symbol deliberately not spelled out in this comment - see the note on the
# RNDIS block above.)
CONFIG_BT_HCIVHCI=y

# The Bluetooth profiles redbull_defconfig leaves out. Android implements
# these in userspace on top of its own stack, so Google had no reason to
# build the kernel side; BlueZ does need them. RFCOMM is serial-over-
# Bluetooth (dialup networking, OBEX file transfer), BNEP is the Ethernet
# emulation that PAN/tethering rides on, HIDP carries Bluetooth keyboards
# and mice. None of these is needed to bring the adapter up or to pair
# audio - they are here so we do not discover three separate missing
# features one kernel rebuild at a time.
#
# The sub-options are not optional extras. Checked against
# net/bluetooth/*/Kconfig in this tree: none of the three carries a
# "default y", so enabling only the parents gives RFCOMM with no TTY
# emulation, meaning no /dev/rfcomm* nodes and nothing for userspace to
# open. Same set as vpsha8888/kernel_redbull barbet-redbull_defconfig,
# which is a working port on this SoC family.
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# What actually works: take over the framebuffer the bootloader has
# *already* painted and is still scanning out, which needs no display
# driver at all. Paired with the root-level framebuffer@a0000000 node in
# google/qcom-base/lito.dts and the no-map on cont_splash_region in
# lito.dtsi (without no-map the driver's ioremap_wc() refuses the region,
# because arm64 will not ioremap normal RAM, and the probe fails with no
# message).
CONFIG_FB_SIMPLE=y

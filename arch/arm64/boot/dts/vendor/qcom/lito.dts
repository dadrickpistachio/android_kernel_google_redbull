/dts-v1/;

#include "lito.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Lito SoC";
	compatible = "qcom,lito";
	qcom,board-id = <0 0>;

	/*
	 * Adopt the framebuffer the bootloader already painted, so the
	 * kernel console is visible on the panel without a display driver.
	 * Address/size mirror cont_splash_region, which is marked no-map so
	 * that ioremap_wc() will accept it (arm64 refuses to ioremap RAM).
	 */
	framebuffer@a0000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xA0000000 0x0 0x009A4000>;
		width = <1080>;
		height = <2340>;
		stride = <4320>;
		format = "x8r8g8b8";
	};
};
